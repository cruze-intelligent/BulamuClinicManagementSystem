generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STAFF)
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  isActive  Boolean  @default(true)
  appointments Appointment[]
  reproductiveHealthRecords ReproductiveHealthRecord[]
  passwordResetTokens PasswordResetToken[]
  documentsUploaded Document[]
  comments  Comment[]
  resolvedAppointmentRequests AppointmentRequest[]
  dispensedPrescriptions Prescription[] @relation("PrescriptionDispensedBy")
  notifications Notification[]
  // Notification types this user has switched email off for (in-app
  // notifications are always kept - only the email copy is optional).
  emailOptOuts NotificationType[] @default([])
  // Platform usage, for the operator's analytics: when they last signed in and
  // when they were last seen using the app (updated at most every few minutes).
  lastLoginAt DateTime?
  lastSeenAt  DateTime?
  // When the user finished (or skipped) the guided walkthrough. It opens by
  // itself only while this is empty - i.e. on their first sign-in, on any
  // device - and can be replayed from Help & FAQ.
  tourCompletedAt DateTime?
  activityDays UserActivityDay[]
  referralsMade        Referral[]      @relation("ReferralReferredBy")
  admissionsAdmitted   Admission[]     @relation("AdmissionAdmittedBy")
  admissionsAttending  Admission[]     @relation("AdmissionAttendingDoctor")
  admissionsDischarged Admission[]     @relation("AdmissionDischargedBy")
  admissionNotes       AdmissionNote[]
  labResultsEntered    LabTest[]       @relation("LabResultedBy")
  labResultsVerified   LabTest[]       @relation("LabVerifiedBy")
  consultationsRecorded Consultation[] @relation("ConsultationRecordedBy")
  paymentsReceived     PatientPayment[] @relation("PaymentReceivedBy")
  paymentsVoided       PatientPayment[] @relation("PaymentVoidedBy")
  expensesRecorded     Expense[]        @relation("ExpenseRecordedBy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
}

// One row per user per day they used the app - the raw material for daily /
// weekly / monthly active users. Only the fact that they were active, never what
// they did. Kept for 13 months (see DATA_RETENTION.md).
model UserActivityDay {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId  String
  // The calendar day in East Africa Time (UTC+3), as a date.
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
  @@index([clinicId, day])
}

enum LoginOutcome {
  SUCCESS
  WRONG_PASSWORD
  BLOCKED
}

// Every staff sign-in attempt against a real account: who (by id, never by the
// typed email) and how it went. Feeds sign-in and security metrics. Kept for 13
// months (see DATA_RETENTION.md).
model LoginEvent {
  id        String       @id @default(uuid())
  userId    String
  clinicId  String
  outcome   LoginOutcome
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([clinicId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Clinic {
  id        String   @id @default(uuid())
  facilityCode String @unique
  name      String
  facilityType FacilityType @default(CLINIC)
  phone     String
  phoneKey  String?
  address   String
  district      String?
  subCounty     String?
  parish        String?
  parentFacilityId String?
  parentFacility   Clinic?  @relation("FacilityHierarchy", fields: [parentFacilityId], references: [id])
  childFacilities  Clinic[] @relation("FacilityHierarchy")
  users     User[]
  patients  Patient[]
  referralsFrom Referral[] @relation("ReferralFrom")
  referralsTo   Referral[] @relation("ReferralTo")
  dhis2Integration Dhis2Integration?
  subscription     Subscription?
  payments         Payment[]
  documents        Document[]
  comments         Comment[]
  createdPatientAccounts PatientAccount[]
  patientAccessGrants    PatientAccessGrant[]
  appointmentRequests    AppointmentRequest[]
  patientAccessOtps      PatientAccessOtp[]
  wards                  Ward[]
  admissions             Admission[]
  historyShares          HistoryShare[]
  isActive  Boolean  @default(true)
  registrationStatus RegistrationStatus @default(PENDING)
  approvedAt    DateTime?
  approvedBy    String?
  rejectionReason String?
  deletedAt     DateTime?
  deletedBy     String?
  // A demonstration facility (for showing Bulamu to prospective clients): never
  // counted in the platform's figures, and its staff are never emailed.
  isDemo        Boolean  @default(false)
  // A demo is private to the person it was sent to and closes on this date.
  demoExpiresAt DateTime?
  logo          ClinicLogo?
  // The last patient receipt number issued; each payment takes the next one,
  // so a facility's receipts run 1, 2, 3... with no gaps or repeats.
  lastReceiptNumber Int @default(0)
  patientPayments   PatientPayment[]
  expenses          Expense[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneKey])
}

// A facility's own logo, printed on its documents (invoices, prescriptions,
// referral letters, discharge summaries). Kept apart from Clinic so the image
// is only ever loaded when a document or the settings page needs it.
model ClinicLogo {
  clinicId  String   @id
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Subscription {
  id               String   @id @default(uuid())
  clinicId         String   @unique
  clinic           Clinic   @relation(fields: [clinicId], references: [id])
  status           SubscriptionStatus @default(TRIALING)
  plan             SubscriptionPlan @default(STANDARD)
  planNotes        String?
  trialEndsAt      DateTime
  // Days the platform operator added to the free trial - at most 14 in all.
  trialExtendedDays Int     @default(0)
  currentPeriodEnd DateTime?
  amount           Int      @default(100000)
  currency         String   @default("UGX")
  lastPaymentAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum SubscriptionPlan {
  STANDARD
  CUSTOM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Payment {
  id                       String   @id @default(uuid())
  clinicId                 String
  clinic                   Clinic   @relation(fields: [clinicId], references: [id])
  subscriptionId           String
  amount                   Int
  currency                 String
  status                   PaymentStatus @default(PENDING)
  pesapalOrderTrackingId   String?  @unique
  pesapalMerchantReference String?  @unique
  rawCallback              Json?
  // The period this payment paid for (for a free-trial receipt: the trial),
  // so a receipt downloaded later still shows its own dates. Empty on
  // payments made before this was recorded.
  periodStart              DateTime?
  periodEnd                DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([clinicId])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  // Pesapal reversed a completed payment (a refund or a chargeback).
  REVERSED
}

model Dhis2Integration {
  id             String   @id @default(uuid())
  clinicId       String   @unique
  clinic         Clinic   @relation(fields: [clinicId], references: [id])
  baseUrl        String
  username       String
  encryptedPassword String
  orgUnitId      String
  dataElementMap Json     @default("{}")
  lastPushedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum FacilityType {
  CLINIC
  HEALTH_CENTRE_II
  HEALTH_CENTRE_III
  HEALTH_CENTRE_IV
  HOSPITAL
  LABORATORY
  PHARMACY
  COMMUNITY_OUTREACH
  MOBILE_UNIT
  IMAGING_CENTRE
}

model Patient {
  id           String        @id @default(uuid())
  name         String
  phone        String
  // Optional contact email - when given at registration, the patient is
  // emailed an invitation to set up their Patient Portal account.
  email        String?
  sex          Sex?
  dateOfBirth  DateTime?
  village      String?
  parish       String?
  subCounty    String?
  district     String?
  nextOfKinName  String?
  nextOfKinPhone String?
  consentGivenAt  DateTime?
  consentGivenBy  String?
  // Drug and other allergies. UNKNOWN means nobody has asked yet (a prompt to
  // ask), NONE_KNOWN means the patient was asked and has none, KNOWN means the
  // list in `allergies` applies: [{ substance, reaction?, severity? }].
  allergyStatus     AllergyStatus @default(UNKNOWN)
  allergies         Json?
  allergiesUpdatedAt DateTime?
  allergiesUpdatedBy String?
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  // Links this facility's own clinical record to the patient's portable,
  // cross-facility identity (nullable - most Patient rows have none until a
  // portal account is created and/or a facility validates access to it).
  patientAccountId String?
  patientAccount    PatientAccount? @relation(fields: [patientAccountId], references: [id])
  appointments Appointment[]
  consultations Consultation[]
  labTests LabTest[]
  reproductiveHealthRecords ReproductiveHealthRecord[]
  referrals    Referral[]
  documents    Document[]
  appointmentRequests AppointmentRequest[]
  admissions   Admission[]
  invoices     Invoice[]
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([clinicId])
  @@index([patientAccountId])
}

enum AllergyStatus {
  UNKNOWN
  NONE_KNOWN
  KNOWN
}

// A patient referred (or transferred on discharge) to another facility. The
// referral itself is the referral letter: the reason, the urgency and the
// clinical summary the referring clinician chose to send, shared with the
// receiving facility only after the clinician records that the patient agreed.
model Referral {
  id           String   @id @default(uuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  fromClinicId String
  fromClinic   Clinic   @relation("ReferralFrom", fields: [fromClinicId], references: [id])
  toClinicId   String
  toClinic     Clinic   @relation("ReferralTo", fields: [toClinicId], references: [id])
  reason       String
  urgency      ReferralUrgency @default(ROUTINE)
  // What the receiving clinician needs: findings, treatment given, why referred.
  clinicalSummary String?
  status       ReferralStatus @default(PENDING)
  referredByUserId String?
  referredBy       User?    @relation("ReferralReferredBy", fields: [referredByUserId], references: [id], onDelete: SetNull)
  // The referring clinician's record that the patient agreed to the referral
  // and to this summary being sent.
  consentRecordedAt DateTime?
  // The receiving facility's reply.
  respondedAt       DateTime?
  respondedByUserId String?
  responseNote      String?
  // The patient's record at the receiving facility, once registered there.
  receivingPatientId String?
  // Set when the referral was made as the outcome of an inpatient discharge.
  admission    Admission?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([fromClinicId])
  @@index([toClinicId])
  @@index([patientId])
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum ReferralUrgency {
  ROUTINE
  URGENT
  EMERGENCY
}

// --- Inpatients ------------------------------------------------------------

// A ward at a facility, with its bed capacity.
model Ward {
  id         String      @id @default(uuid())
  clinicId   String
  clinic     Clinic      @relation(fields: [clinicId], references: [id])
  name       String
  type       WardType    @default(GENERAL)
  beds       Int
  isActive   Boolean     @default(true)
  admissions Admission[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([clinicId, name])
}

enum WardType {
  GENERAL
  MALE
  FEMALE
  MATERNITY
  PAEDIATRIC
  SURGICAL
  ICU
  ISOLATION
  PRIVATE
  OTHER
}

// One inpatient stay, from admission to discharge.
model Admission {
  id                 String           @id @default(uuid())
  clinicId           String
  clinic             Clinic           @relation(fields: [clinicId], references: [id])
  patientId          String
  patient            Patient          @relation(fields: [patientId], references: [id])
  wardId             String
  ward               Ward             @relation(fields: [wardId], references: [id])
  bed                String?
  status             AdmissionStatus  @default(ADMITTED)
  // Why the patient was admitted / the admitting (provisional) diagnosis.
  reason             String
  admissionIcd10Code String?
  attendingDoctorId  String?
  attendingDoctor    User?            @relation("AdmissionAttendingDoctor", fields: [attendingDoctorId], references: [id], onDelete: SetNull)
  admittedByUserId   String
  admittedBy         User             @relation("AdmissionAdmittedBy", fields: [admittedByUserId], references: [id])
  admittedAt         DateTime         @default(now())
  // Discharge
  dischargedAt         DateTime?
  dischargedByUserId   String?
  dischargedBy         User?          @relation("AdmissionDischargedBy", fields: [dischargedByUserId], references: [id], onDelete: SetNull)
  outcome              DischargeOutcome?
  dischargeDiagnosis   String?
  dischargeIcd10Code   String?
  dischargeSummary     String?
  followUpInstructions String?
  // A discharge by referral/transfer creates the referral that goes with the patient.
  referralId           String?        @unique
  referral             Referral?      @relation(fields: [referralId], references: [id])
  notes                AdmissionNote[]
  // Bill lines charging for the stay (a long stay may be billed in parts).
  invoiceItems         InvoiceItem[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([clinicId, status])
  @@index([wardId, status])
  @@index([patientId])
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
}

// How the stay ended - the categories used in inpatient (HMIS 108) reporting.
enum DischargeOutcome {
  RECOVERED
  IMPROVED
  REFERRED
  LEFT_AGAINST_ADVICE
  ABSCONDED
  DIED
}

// Nursing notes, doctor's ward-round notes, observations (vitals) and ward
// transfers during a stay. Never edited - a correction is a new note.
model AdmissionNote {
  id           String            @id @default(uuid())
  admissionId  String
  admission    Admission         @relation(fields: [admissionId], references: [id])
  authorUserId String
  author       User              @relation(fields: [authorUserId], references: [id])
  authorRole   Role
  kind         AdmissionNoteKind
  note         String?
  // { temperatureC, pulse, respiratoryRate, systolic, diastolic, spo2, weightKg }
  vitals       Json?
  createdAt    DateTime          @default(now())

  @@index([admissionId, createdAt])
}

enum AdmissionNoteKind {
  NURSING_NOTE
  WARD_ROUND
  OBSERVATION
  TRANSFER
}

enum Sex {
  FEMALE
  MALE
  OTHER
}

model ReproductiveHealthRecord {
  id                      String   @id @default(uuid())
  patientId               String
  patient                 Patient  @relation(fields: [patientId], references: [id])
  recordedById            String
  recordedBy              User     @relation(fields: [recordedById], references: [id])
  lastMenstrualPeriodDate DateTime?
  cycleLengthDays         Int?
  flowDurationDays        Int?
  familyPlanningMethod    FamilyPlanningMethod @default(NONE)
  pregnancyStatus         PregnancyStatus @default(UNKNOWN)
  gravida                 Int?
  para                    Int?
  notes                   String?
  deletedAt               DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([patientId])
}

enum FamilyPlanningMethod {
  NONE
  CONDOM
  PILL
  INJECTABLE
  IMPLANT
  IUD
  NATURAL
  PERMANENT
  OTHER
}

enum PregnancyStatus {
  UNKNOWN
  NOT_PREGNANT
  PREGNANT
  POSTPARTUM
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  PHARMACIST
  NURSE
  STAFF
  // Runs the laboratory: receives orders and enters results.
  LAB_TECH
}

model Appointment {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      User     @relation(fields: [doctorId], references: [id])
  clinicId    String
  date        DateTime
  time        String
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  consultation Consultation?
  appointmentRequest AppointmentRequest?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clinicId, date])
  @@index([patientId])
  @@index([doctorId])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Consultation {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  diagnosis     String
  symptoms      String
  // Assessment, plan and advice given - the clinician's free-text narrative
  // beyond the structured diagnoses and prescriptions.
  clinicalNotes String?
  // The clinician who recorded the visit (empty on visits recorded before this was kept).
  recordedByUserId String?
  recordedBy       User?    @relation("ConsultationRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  serviceTags   String[] @default([])
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  invoice       Invoice?
  labTests LabTest[]
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([patientId])
}

// One diagnosis made at a consultation. A consultation has one PRIMARY
// (the main reason for the visit) and any number of SECONDARY diagnoses
// (co-morbidities, complications). icd10Code is optional: a clinician can code
// it (B54, J18.9...) or just describe it, and the code drives reporting.
model Diagnosis {
  id             String             @id @default(uuid())
  consultationId String
  consultation   Consultation       @relation(fields: [consultationId], references: [id])
  icd10Code      String?
  description    String
  type           DiagnosisType      @default(PRIMARY)
  certainty      DiagnosisCertainty @default(CONFIRMED)
  notes          String?
  createdAt      DateTime           @default(now())

  @@index([consultationId])
  @@index([icd10Code])
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
}

// CONFIRMED: established (e.g. positive RDT). PROVISIONAL: suspected or
// working diagnosis, still to be confirmed or ruled out.
enum DiagnosisCertainty {
  CONFIRMED
  PROVISIONAL
}

// One prescribed item. medication/dosage/frequency/duration are the original
// free-text fields and stay for records made before structured prescribing;
// the rest describe the drug precisely (strength, form, route) and how much to
// supply, the way a paper prescription does.
model Prescription {
  id              String       @id @default(uuid())
  consultationId  String
  consultation    Consultation @relation(fields: [consultationId], references: [id])
  medication      String
  strength        String?
  form            String?
  dosage          String
  route           String?
  frequency       String
  duration        String
  quantity        Int?
  instructions    String?
  // Soft link to the facility's stock item this was prescribed from, so the
  // pharmacist knows exactly what to dispense. Nullable: the drug may not be
  // stocked, or the stock item may since have been removed.
  medicineId      String?
  medicine        Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  // Set when the prescriber saw a recorded allergy that matched this medicine
  // and chose to prescribe it anyway - a safety trail, not a permission.
  allergyOverride Boolean      @default(false)
  // Dispensing: filled in by the pharmacist. dispensedQuantity is what left the
  // shelf (and was taken off the linked stock item, when there is one).
  dispensedAt       DateTime?
  dispensedByUserId String?
  dispensedBy       User?      @relation("PrescriptionDispensedBy", fields: [dispensedByUserId], references: [id], onDelete: SetNull)
  dispensedQuantity Int?
  // The bill line it was charged on, if any.
  invoiceItem     InvoiceItem?
  createdAt       DateTime     @default(now())

  @@index([consultationId])
  @@index([medicineId])
  @@index([dispensedAt])
}

// A facility's bill to its patient - the facility charges and collects, Bulamu
// keeps the record. Most bills belong to a visit; a bill without one covers a
// walk-in (medicine bought over the counter, a lab test on its own).
// amount is the sum of the items and amountPaid the sum of the payments that
// stand (not voided); both are kept in step by the server on every change.
model Invoice {
  id              String        @id @default(uuid())
  consultationId  String?       @unique
  consultation    Consultation? @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id])
  clinicId        String
  amount          Float
  amountPaid      Float         @default(0)
  status          InvoiceStatus @default(PENDING)
  // When the bill was paid in full (empty while anything is still owed).
  paidAt          DateTime?
  createdByUserId String?
  items           InvoiceItem[]
  payments        PatientPayment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clinicId, status])
  @@index([patientId])
}

// One line on a bill. A charge for a lab test or a prescribed medicine points
// at it, so the same test or medicine can never be billed twice.
model InvoiceItem {
  id             String     @id @default(uuid())
  invoiceId      String
  invoice        Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind           ChargeKind
  description    String
  quantity       Int        @default(1)
  unitPrice      Int
  amount         Int
  labTestId      String?       @unique
  labTest        LabTest?      @relation(fields: [labTestId], references: [id], onDelete: SetNull)
  prescriptionId String?       @unique
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  // For a ward stay: the admission it charges for (nights charged add up across lines).
  admissionId    String?
  admission      Admission?    @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  addedByUserId  String?
  createdAt      DateTime   @default(now())

  @@index([invoiceId])
  @@index([admissionId])
}

enum ChargeKind {
  CONSULTATION
  LAB
  MEDICINE
  PROCEDURE
  ADMISSION
  OTHER
}

// Money a facility received from (or for) a patient against a bill. Each has
// the facility's next receipt number. A payment is never deleted: one taken by
// mistake is voided by an administrator, with the reason, and its receipt then
// reads VOID.
model PatientPayment {
  id               String         @id @default(uuid())
  clinicId         String
  clinic           Clinic         @relation(fields: [clinicId], references: [id])
  invoiceId        String
  invoice          Invoice        @relation(fields: [invoiceId], references: [id])
  receiptNumber    Int
  amount           Int
  // Empty on payments recorded before the method was kept.
  method           PaymentMethod?
  // Mobile money transaction ID, card slip, bank reference or insurance claim number.
  reference        String?
  // Who paid, when it was not the patient (a relative, an employer).
  payerName        String?
  receivedByUserId String?
  receivedBy       User?          @relation("PaymentReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  receivedAt       DateTime       @default(now())
  voidedAt         DateTime?
  voidedByUserId   String?
  voidedBy         User?          @relation("PaymentVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  voidReason       String?
  createdAt        DateTime       @default(now())

  @@unique([clinicId, receiptNumber])
  @@index([clinicId, receivedAt])
  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  BANK
  INSURANCE
}

// Money a facility paid out: stock, salaries, rent, bills - so it can see what
// came in against what went out. Kept like payments: voided, never deleted.
model Expense {
  id               String          @id @default(uuid())
  clinicId         String
  clinic           Clinic          @relation(fields: [clinicId], references: [id])
  category         ExpenseCategory
  description      String
  amount           Int
  // The day the money was paid.
  spentOn          DateTime
  method           PaymentMethod?
  paidTo           String?
  reference        String?
  recordedByUserId String?
  recordedBy       User?           @relation("ExpenseRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  voidedAt         DateTime?
  voidedByUserId   String?
  voidReason       String?
  createdAt        DateTime        @default(now())

  @@index([clinicId, spentOn])
}

enum ExpenseCategory {
  MEDICINES_SUPPLIES
  SALARIES
  RENT
  UTILITIES
  EQUIPMENT
  TRANSPORT
  OTHER
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

model Medicine {
  id          String   @id @default(uuid())
  clinicId    String
  name        String
  quantity    Int
  unit        String
  reorderLevel Int
  price       Float
  expiryDate  DateTime?
  prescriptions Prescription[]
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clinicId])
}

model LabTest {
  id              String   @id @default(uuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  consultationId  String?
  consultation    Consultation? @relation(fields: [consultationId], references: [id])
  testName        String
  results         String
  status          LabStatus @default(PENDING)
  orderedBy       String
  // The account that placed the order (set by the server, never trusted from
  // the client) - who is told when the result is ready.
  orderedByUserId String?
  completedAt     DateTime?
  // Who entered the result, and the clinician who checked it before it was
  // released to the patient. A verified result is locked: changing it is an
  // amendment, with a reason, and needs verifying again.
  resultedByUserId String?
  resultedBy       User?     @relation("LabResultedBy", fields: [resultedByUserId], references: [id], onDelete: SetNull)
  resultedAt       DateTime?
  verifiedByUserId String?
  verifiedBy       User?     @relation("LabVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verifiedAt       DateTime?
  // The bill line it was charged on, if any.
  invoiceItem      InvoiceItem?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([patientId])
  @@index([consultationId])
}

enum LabStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model SyncConflictLog {
  id               String   @id @default(uuid())
  entity           String
  recordId         String
  clinicId         String
  mutationId       String
  incomingUpdatedAt DateTime
  currentUpdatedAt  DateTime
  createdAt        DateTime @default(now())

  @@index([clinicId])
  @@index([recordId])
}

model Document {
  id             String           @id @default(uuid())
  clinicId       String
  clinic         Clinic           @relation(fields: [clinicId], references: [id])
  patientId      String?
  patient        Patient?         @relation(fields: [patientId], references: [id])
  category       DocumentCategory @default(OTHER)
  fileName       String
  mimeType       String
  fileSize       Int
  storageKey     String
  // Exactly one of these two is set: staff-uploaded documents carry
  // uploadedByUserId, patient-uploaded ones (via the patient portal) carry
  // uploadedByPatientAccountId - never both, never neither.
  uploadedByUserId String?
  uploadedBy     User?            @relation(fields: [uploadedByUserId], references: [id])
  uploadedByPatientAccountId String?
  uploadedByPatientAccount   PatientAccount? @relation(fields: [uploadedByPatientAccountId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([clinicId])
  @@index([patientId])
  @@index([uploadedByPatientAccountId])
}

enum DocumentCategory {
  LAB_RESULT
  CONSENT_FORM
  ID_COPY
  REFERRAL_LETTER
  PATIENT_UPLOAD
  OTHER
}

model AuditLog {
  id         String   @id @default(uuid())
  entity     String
  recordId   String
  clinicId   String
  action     AuditAction
  actorUserId String
  actorRole  String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([clinicId])
  @@index([entity, recordId])
}

enum AuditAction {
  CREATE
  UPDATE
  DEACTIVATE
  DELETE
  VIEW
}

// General product feedback (FEEDBACK, no linked record) and per-record notes
// staff of different roles leave for each other (PATIENT today).
model Comment {
  id         String            @id @default(uuid())
  clinicId   String
  clinic     Clinic            @relation(fields: [clinicId], references: [id])
  authorId   String
  author     User              @relation(fields: [authorId], references: [id])
  authorRole Role
  entityType CommentEntityType
  entityId   String?
  body       String
  createdAt  DateTime          @default(now())

  @@index([clinicId, entityType, entityId])
}

enum CommentEntityType {
  FEEDBACK
  PATIENT
}

// A patient's portable, cross-facility identity. Created only by an
// authenticated staff member at the facility registering the patient -
// never a public self-service endpoint, which would let anyone claim to be
// any patient. Each facility keeps its own separate Patient row for its own
// clinical data; this only links rows belonging to the same real person, so
// the patient's own portal session can show an aggregated view of their
// care across every facility they've validated their credentials with.
model PatientAccount {
  id                String                      @id @default(uuid())
  portableId        String                      @unique
  phone             String
  phoneKey          String
  email             String                      @unique
  password          String
  status            PatientAccountStatus        @default(ACTIVE)
  mustResetPassword Boolean                     @default(true)
  createdByClinicId String
  createdByClinic   Clinic                      @relation(fields: [createdByClinicId], references: [id])
  createdByUserId   String
  patients          Patient[]
  accessGrants      PatientAccessGrant[]
  resetTokens       PatientPasswordResetToken[]
  uploadedDocuments Document[]
  appointmentRequests AppointmentRequest[]
  accessOtps        PatientAccessOtp[]
  notifications     Notification[]
  historyShares     HistoryShare[]
  emailOptOuts      NotificationType[]          @default([])
  // Set when the patient closes their account: the row is kept as an
  // anonymised tombstone because audit entries, grants and appointment
  // requests reference it (see DATA_RETENTION.md).
  closedAt          DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([phoneKey])
}

enum PatientAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

// The explicit, auditable, revocable trust boundary for cross-facility
// access. A facility only ever appears in a patient's aggregated portal
// view - and was only ever authorized to link its own Patient row to this
// account - if an active grant (revokedAt null) exists here.
model PatientAccessGrant {
  id               String                    @id @default(uuid())
  patientAccountId String
  patientAccount   PatientAccount            @relation(fields: [patientAccountId], references: [id])
  clinicId         String
  clinic           Clinic                    @relation(fields: [clinicId], references: [id])
  method           PatientAccessGrantMethod
  grantedByUserId  String
  grantedAt        DateTime                  @default(now())
  revokedAt        DateTime?
  revokedByUserId  String?

  @@index([patientAccountId])
  @@index([clinicId])
}

// Being linked to a patient does NOT let a facility read that patient's history
// from other facilities. That needs the patient's own, explicit approval - with
// their password or a code sent to them at the facility, or from their Patient
// Portal - recorded here, and withdrawable by the patient at any time.
model HistoryShare {
  id                String               @id @default(uuid())
  patientAccountId  String
  patientAccount    PatientAccount       @relation(fields: [patientAccountId], references: [id])
  // The facility allowed to read.
  clinicId          String
  clinic            Clinic               @relation(fields: [clinicId], references: [id])
  status            HistoryShareStatus   @default(REQUESTED)
  requestedByUserId String
  requestedAt       DateTime             @default(now())
  approvedAt        DateTime?
  approvalMethod    HistoryConsentMethod?
  // Withdrawn by the patient, or declined by them while still a request.
  endedAt           DateTime?

  @@index([patientAccountId, status])
  @@index([clinicId, status])
}

enum HistoryShareStatus {
  REQUESTED
  APPROVED
  DECLINED
  WITHDRAWN
}

enum HistoryConsentMethod {
  PIN
  OTP
  PORTAL
}

enum PatientAccessGrantMethod {
  PIN
  OTP
}

model PatientPasswordResetToken {
  id               String         @id @default(uuid())
  patientAccountId String
  patientAccount   PatientAccount @relation(fields: [patientAccountId], references: [id])
  tokenHash        String         @unique
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime       @default(now())

  @@index([patientAccountId])
}

// A patient-initiated appointment request. Patients can only request at a
// clinic where a Patient row is already linked to their account (i.e. one
// that created their portal account, or - once the cross-facility grant flow
// exists - one that was explicitly granted access), so patientId is always
// known up front. Staff confirm by assigning a doctor/date and creating the
// real Appointment (resultingAppointmentId), or decline it.
model AppointmentRequest {
  id                     String                   @id @default(uuid())
  patientAccountId       String
  patientAccount         PatientAccount           @relation(fields: [patientAccountId], references: [id])
  patientId              String
  patient                Patient                  @relation(fields: [patientId], references: [id])
  clinicId               String
  clinic                 Clinic                   @relation(fields: [clinicId], references: [id])
  preferredDate          DateTime
  preferredTime          String?
  reason                 String?
  status                 AppointmentRequestStatus @default(PENDING)
  resultingAppointmentId String?                  @unique
  resultingAppointment   Appointment?             @relation(fields: [resultingAppointmentId], references: [id])
  resolvedByUserId       String?
  resolvedByUser         User?                    @relation(fields: [resolvedByUserId], references: [id])
  resolvedAt             DateTime?
  declineReason          String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([clinicId, status])
  @@index([patientAccountId])
}

enum AppointmentRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

// A short-lived, single-use OTP proving a patient physically present at a
// new facility is really who they claim (the "OTP" PatientAccessGrantMethod).
// Scoped to one (patientAccountId, clinicId) pair so an OTP requested for one
// facility can't be replayed to link the account at a different one.
model PatientAccessOtp {
  id               String         @id @default(uuid())
  patientAccountId String
  patientAccount   PatientAccount @relation(fields: [patientAccountId], references: [id])
  clinicId         String
  clinic           Clinic         @relation(fields: [clinicId], references: [id])
  codeHash         String
  // What the code approves: LINK (link the account at this facility) or
  // HISTORY (let this facility read history from other facilities). A code
  // issued for one can never be used for the other.
  purpose          String         @default("LINK")
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime       @default(now())

  @@index([patientAccountId, clinicId])
}

// What the notification is about. Which roles receive each type, and whether
// they also get an email, is defined in one place: NOTIFICATION_RULES in
// src/lib/notifications.ts.
enum NotificationType {
  LAB_RESULT_READY
  LOW_STOCK
  NEW_PRESCRIPTION
  APPOINTMENT_REQUESTED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_DECLINED
  REFERRAL_RECEIVED
  RECORD_ACCESS_GRANTED
  NEW_NOTE
  OUT_OF_STOCK
  STOCK_EXPIRING
  LAB_TEST_ORDERED
  LAB_RESULT_AVAILABLE
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  REFERRAL_UPDATED
  PATIENT_ADMITTED
  PATIENT_DISCHARGED
  HISTORY_ACCESS_APPROVED
  SUBSCRIPTION_REMINDER
  PAYMENT_RECEIVED
  REFERRAL_ISSUED
  DISCHARGE_SUMMARY_READY
  HISTORY_SHARING_APPROVED
  HISTORY_ACCESS_REQUESTED
}

// An in-app notification for exactly one recipient: either a staff user or a
// patient portal account. Titles and bodies may name patients or tests because
// they are only ever shown after sign-in; the emailed copy is deliberately
// generic and carries no clinical detail.
model Notification {
  id               String           @id @default(uuid())
  userId           String?
  user             User?            @relation(fields: [userId], references: [id])
  patientAccountId String?
  patientAccount   PatientAccount?  @relation(fields: [patientAccountId], references: [id])
  clinicId         String?
  type             NotificationType
  title            String
  body             String
  link             String?
  // For reminders raised by a periodic check (stock expiring, trial ending):
  // the same key is never notified twice, however often the check runs.
  dedupeKey        String?
  readAt           DateTime?
  createdAt        DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([patientAccountId, createdAt])
  @@index([clinicId, dedupeKey])
}
