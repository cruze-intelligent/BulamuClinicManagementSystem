generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STAFF)
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  isActive  Boolean  @default(true)
  appointments Appointment[]
  reproductiveHealthRecords ReproductiveHealthRecord[]
  passwordResetTokens PasswordResetToken[]
  documentsUploaded Document[]
  comments  Comment[]
  resolvedAppointmentRequests AppointmentRequest[]
  notifications Notification[]
  // Notification types this user has switched email off for (in-app
  // notifications are always kept - only the email copy is optional).
  emailOptOuts NotificationType[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Clinic {
  id        String   @id @default(uuid())
  facilityCode String @unique
  name      String
  facilityType FacilityType @default(CLINIC)
  phone     String
  phoneKey  String?
  address   String
  district      String?
  subCounty     String?
  parish        String?
  parentFacilityId String?
  parentFacility   Clinic?  @relation("FacilityHierarchy", fields: [parentFacilityId], references: [id])
  childFacilities  Clinic[] @relation("FacilityHierarchy")
  users     User[]
  patients  Patient[]
  referralsFrom Referral[] @relation("ReferralFrom")
  referralsTo   Referral[] @relation("ReferralTo")
  dhis2Integration Dhis2Integration?
  subscription     Subscription?
  payments         Payment[]
  documents        Document[]
  comments         Comment[]
  createdPatientAccounts PatientAccount[]
  patientAccessGrants    PatientAccessGrant[]
  appointmentRequests    AppointmentRequest[]
  patientAccessOtps      PatientAccessOtp[]
  isActive  Boolean  @default(true)
  registrationStatus RegistrationStatus @default(PENDING)
  approvedAt    DateTime?
  approvedBy    String?
  rejectionReason String?
  deletedAt     DateTime?
  deletedBy     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneKey])
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Subscription {
  id               String   @id @default(uuid())
  clinicId         String   @unique
  clinic           Clinic   @relation(fields: [clinicId], references: [id])
  status           SubscriptionStatus @default(TRIALING)
  plan             SubscriptionPlan @default(STANDARD)
  planNotes        String?
  trialEndsAt      DateTime
  currentPeriodEnd DateTime?
  amount           Int      @default(100000)
  currency         String   @default("UGX")
  lastPaymentAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum SubscriptionPlan {
  STANDARD
  CUSTOM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Payment {
  id                       String   @id @default(uuid())
  clinicId                 String
  clinic                   Clinic   @relation(fields: [clinicId], references: [id])
  subscriptionId           String
  amount                   Int
  currency                 String
  status                   PaymentStatus @default(PENDING)
  pesapalOrderTrackingId   String?  @unique
  pesapalMerchantReference String?  @unique
  rawCallback              Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([clinicId])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Dhis2Integration {
  id             String   @id @default(uuid())
  clinicId       String   @unique
  clinic         Clinic   @relation(fields: [clinicId], references: [id])
  baseUrl        String
  username       String
  encryptedPassword String
  orgUnitId      String
  dataElementMap Json     @default("{}")
  lastPushedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum FacilityType {
  CLINIC
  HEALTH_CENTRE_II
  HEALTH_CENTRE_III
  HEALTH_CENTRE_IV
  HOSPITAL
  LABORATORY
  PHARMACY
  COMMUNITY_OUTREACH
  MOBILE_UNIT
  IMAGING_CENTRE
}

model Patient {
  id           String        @id @default(uuid())
  name         String
  phone        String
  // Optional contact email - when given at registration, the patient is
  // emailed an invitation to set up their Patient Portal account.
  email        String?
  sex          Sex?
  dateOfBirth  DateTime?
  village      String?
  parish       String?
  subCounty    String?
  district     String?
  nextOfKinName  String?
  nextOfKinPhone String?
  consentGivenAt  DateTime?
  consentGivenBy  String?
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  // Links this facility's own clinical record to the patient's portable,
  // cross-facility identity (nullable - most Patient rows have none until a
  // portal account is created and/or a facility validates access to it).
  patientAccountId String?
  patientAccount    PatientAccount? @relation(fields: [patientAccountId], references: [id])
  appointments Appointment[]
  consultations Consultation[]
  labTests LabTest[]
  reproductiveHealthRecords ReproductiveHealthRecord[]
  referrals    Referral[]
  documents    Document[]
  appointmentRequests AppointmentRequest[]
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([clinicId])
  @@index([patientAccountId])
}

model Referral {
  id           String   @id @default(uuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  fromClinicId String
  fromClinic   Clinic   @relation("ReferralFrom", fields: [fromClinicId], references: [id])
  toClinicId   String
  toClinic     Clinic   @relation("ReferralTo", fields: [toClinicId], references: [id])
  reason       String
  status       ReferralStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([fromClinicId])
  @@index([toClinicId])
  @@index([patientId])
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum Sex {
  FEMALE
  MALE
  OTHER
}

model ReproductiveHealthRecord {
  id                      String   @id @default(uuid())
  patientId               String
  patient                 Patient  @relation(fields: [patientId], references: [id])
  recordedById            String
  recordedBy              User     @relation(fields: [recordedById], references: [id])
  lastMenstrualPeriodDate DateTime?
  cycleLengthDays         Int?
  flowDurationDays        Int?
  familyPlanningMethod    FamilyPlanningMethod @default(NONE)
  pregnancyStatus         PregnancyStatus @default(UNKNOWN)
  gravida                 Int?
  para                    Int?
  notes                   String?
  deletedAt               DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([patientId])
}

enum FamilyPlanningMethod {
  NONE
  CONDOM
  PILL
  INJECTABLE
  IMPLANT
  IUD
  NATURAL
  PERMANENT
  OTHER
}

enum PregnancyStatus {
  UNKNOWN
  NOT_PREGNANT
  PREGNANT
  POSTPARTUM
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  PHARMACIST
  NURSE
  STAFF
}

model Appointment {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      User     @relation(fields: [doctorId], references: [id])
  clinicId    String
  date        DateTime
  time        String
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  consultation Consultation?
  appointmentRequest AppointmentRequest?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clinicId, date])
  @@index([patientId])
  @@index([doctorId])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Consultation {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  diagnosis     String
  symptoms      String
  // Assessment, plan and advice given - the clinician's free-text narrative
  // beyond the structured diagnoses and prescriptions.
  clinicalNotes String?
  serviceTags   String[] @default([])
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  invoice       Invoice?
  labTests LabTest[]
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([patientId])
}

// One diagnosis made at a consultation. A consultation has one PRIMARY
// (the main reason for the visit) and any number of SECONDARY diagnoses
// (co-morbidities, complications). icd10Code is optional: a clinician can code
// it (B54, J18.9...) or just describe it, and the code drives reporting.
model Diagnosis {
  id             String             @id @default(uuid())
  consultationId String
  consultation   Consultation       @relation(fields: [consultationId], references: [id])
  icd10Code      String?
  description    String
  type           DiagnosisType      @default(PRIMARY)
  certainty      DiagnosisCertainty @default(CONFIRMED)
  notes          String?
  createdAt      DateTime           @default(now())

  @@index([consultationId])
  @@index([icd10Code])
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
}

// CONFIRMED: established (e.g. positive RDT). PROVISIONAL: suspected or
// working diagnosis, still to be confirmed or ruled out.
enum DiagnosisCertainty {
  CONFIRMED
  PROVISIONAL
}

// One prescribed item. medication/dosage/frequency/duration are the original
// free-text fields and stay for records made before structured prescribing;
// the rest describe the drug precisely (strength, form, route) and how much to
// supply, the way a paper prescription does.
model Prescription {
  id              String       @id @default(uuid())
  consultationId  String
  consultation    Consultation @relation(fields: [consultationId], references: [id])
  medication      String
  strength        String?
  form            String?
  dosage          String
  route           String?
  frequency       String
  duration        String
  quantity        Int?
  instructions    String?
  // Soft link to the facility's stock item this was prescribed from, so the
  // pharmacist knows exactly what to dispense. Nullable: the drug may not be
  // stocked, or the stock item may since have been removed.
  medicineId      String?
  medicine        Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())

  @@index([consultationId])
  @@index([medicineId])
}

model Invoice {
  id              String       @id @default(uuid())
  consultationId  String       @unique
  consultation    Consultation @relation(fields: [consultationId], references: [id])
  clinicId        String
  amount          Float
  status          InvoiceStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([clinicId, status])
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

model Medicine {
  id          String   @id @default(uuid())
  clinicId    String
  name        String
  quantity    Int
  unit        String
  reorderLevel Int
  price       Float
  expiryDate  DateTime?
  prescriptions Prescription[]
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clinicId])
}

model LabTest {
  id              String   @id @default(uuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  consultationId  String?
  consultation    Consultation? @relation(fields: [consultationId], references: [id])
  testName        String
  results         String
  status          LabStatus @default(PENDING)
  orderedBy       String
  completedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([patientId])
  @@index([consultationId])
}

enum LabStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model SyncConflictLog {
  id               String   @id @default(uuid())
  entity           String
  recordId         String
  clinicId         String
  mutationId       String
  incomingUpdatedAt DateTime
  currentUpdatedAt  DateTime
  createdAt        DateTime @default(now())

  @@index([clinicId])
  @@index([recordId])
}

model Document {
  id             String           @id @default(uuid())
  clinicId       String
  clinic         Clinic           @relation(fields: [clinicId], references: [id])
  patientId      String?
  patient        Patient?         @relation(fields: [patientId], references: [id])
  category       DocumentCategory @default(OTHER)
  fileName       String
  mimeType       String
  fileSize       Int
  storageKey     String
  // Exactly one of these two is set: staff-uploaded documents carry
  // uploadedByUserId, patient-uploaded ones (via the patient portal) carry
  // uploadedByPatientAccountId - never both, never neither.
  uploadedByUserId String?
  uploadedBy     User?            @relation(fields: [uploadedByUserId], references: [id])
  uploadedByPatientAccountId String?
  uploadedByPatientAccount   PatientAccount? @relation(fields: [uploadedByPatientAccountId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([clinicId])
  @@index([patientId])
  @@index([uploadedByPatientAccountId])
}

enum DocumentCategory {
  LAB_RESULT
  CONSENT_FORM
  ID_COPY
  REFERRAL_LETTER
  PATIENT_UPLOAD
  OTHER
}

model AuditLog {
  id         String   @id @default(uuid())
  entity     String
  recordId   String
  clinicId   String
  action     AuditAction
  actorUserId String
  actorRole  String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([clinicId])
  @@index([entity, recordId])
}

enum AuditAction {
  CREATE
  UPDATE
  DEACTIVATE
  DELETE
}

// General product feedback (FEEDBACK, no linked record) and per-record notes
// staff of different roles leave for each other (PATIENT today).
model Comment {
  id         String            @id @default(uuid())
  clinicId   String
  clinic     Clinic            @relation(fields: [clinicId], references: [id])
  authorId   String
  author     User              @relation(fields: [authorId], references: [id])
  authorRole Role
  entityType CommentEntityType
  entityId   String?
  body       String
  createdAt  DateTime          @default(now())

  @@index([clinicId, entityType, entityId])
}

enum CommentEntityType {
  FEEDBACK
  PATIENT
}

// A patient's portable, cross-facility identity. Created only by an
// authenticated staff member at the facility registering the patient -
// never a public self-service endpoint, which would let anyone claim to be
// any patient. Each facility keeps its own separate Patient row for its own
// clinical data; this only links rows belonging to the same real person, so
// the patient's own portal session can show an aggregated view of their
// care across every facility they've validated their credentials with.
model PatientAccount {
  id                String                      @id @default(uuid())
  portableId        String                      @unique
  phone             String
  phoneKey          String
  email             String                      @unique
  password          String
  status            PatientAccountStatus        @default(ACTIVE)
  mustResetPassword Boolean                     @default(true)
  createdByClinicId String
  createdByClinic   Clinic                      @relation(fields: [createdByClinicId], references: [id])
  createdByUserId   String
  patients          Patient[]
  accessGrants      PatientAccessGrant[]
  resetTokens       PatientPasswordResetToken[]
  uploadedDocuments Document[]
  appointmentRequests AppointmentRequest[]
  accessOtps        PatientAccessOtp[]
  notifications     Notification[]
  emailOptOuts      NotificationType[]          @default([])
  // Set when the patient closes their account: the row is kept as an
  // anonymised tombstone because audit entries, grants and appointment
  // requests reference it (see DATA_RETENTION.md).
  closedAt          DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([phoneKey])
}

enum PatientAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

// The explicit, auditable, revocable trust boundary for cross-facility
// access. A facility only ever appears in a patient's aggregated portal
// view - and was only ever authorized to link its own Patient row to this
// account - if an active grant (revokedAt null) exists here.
model PatientAccessGrant {
  id               String                    @id @default(uuid())
  patientAccountId String
  patientAccount   PatientAccount            @relation(fields: [patientAccountId], references: [id])
  clinicId         String
  clinic           Clinic                    @relation(fields: [clinicId], references: [id])
  method           PatientAccessGrantMethod
  grantedByUserId  String
  grantedAt        DateTime                  @default(now())
  revokedAt        DateTime?
  revokedByUserId  String?

  @@index([patientAccountId])
  @@index([clinicId])
}

enum PatientAccessGrantMethod {
  PIN
  OTP
}

model PatientPasswordResetToken {
  id               String         @id @default(uuid())
  patientAccountId String
  patientAccount   PatientAccount @relation(fields: [patientAccountId], references: [id])
  tokenHash        String         @unique
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime       @default(now())

  @@index([patientAccountId])
}

// A patient-initiated appointment request. Patients can only request at a
// clinic where a Patient row is already linked to their account (i.e. one
// that created their portal account, or - once the cross-facility grant flow
// exists - one that was explicitly granted access), so patientId is always
// known up front. Staff confirm by assigning a doctor/date and creating the
// real Appointment (resultingAppointmentId), or decline it.
model AppointmentRequest {
  id                     String                   @id @default(uuid())
  patientAccountId       String
  patientAccount         PatientAccount           @relation(fields: [patientAccountId], references: [id])
  patientId              String
  patient                Patient                  @relation(fields: [patientId], references: [id])
  clinicId               String
  clinic                 Clinic                   @relation(fields: [clinicId], references: [id])
  preferredDate          DateTime
  preferredTime          String?
  reason                 String?
  status                 AppointmentRequestStatus @default(PENDING)
  resultingAppointmentId String?                  @unique
  resultingAppointment   Appointment?             @relation(fields: [resultingAppointmentId], references: [id])
  resolvedByUserId       String?
  resolvedByUser         User?                    @relation(fields: [resolvedByUserId], references: [id])
  resolvedAt             DateTime?
  declineReason          String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([clinicId, status])
  @@index([patientAccountId])
}

enum AppointmentRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

// A short-lived, single-use OTP proving a patient physically present at a
// new facility is really who they claim (the "OTP" PatientAccessGrantMethod).
// Scoped to one (patientAccountId, clinicId) pair so an OTP requested for one
// facility can't be replayed to link the account at a different one.
model PatientAccessOtp {
  id               String         @id @default(uuid())
  patientAccountId String
  patientAccount   PatientAccount @relation(fields: [patientAccountId], references: [id])
  clinicId         String
  clinic           Clinic         @relation(fields: [clinicId], references: [id])
  codeHash         String
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime       @default(now())

  @@index([patientAccountId, clinicId])
}

// What the notification is about. Which roles receive each type, and whether
// they also get an email, is defined in one place: NOTIFICATION_RULES in
// src/lib/notifications.ts.
enum NotificationType {
  LAB_RESULT_READY
  LOW_STOCK
  NEW_PRESCRIPTION
  APPOINTMENT_REQUESTED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_DECLINED
  REFERRAL_RECEIVED
  RECORD_ACCESS_GRANTED
  NEW_NOTE
}

// An in-app notification for exactly one recipient: either a staff user or a
// patient portal account. Titles and bodies may name patients or tests because
// they are only ever shown after sign-in; the emailed copy is deliberately
// generic and carries no clinical detail.
model Notification {
  id               String           @id @default(uuid())
  userId           String?
  user             User?            @relation(fields: [userId], references: [id])
  patientAccountId String?
  patientAccount   PatientAccount?  @relation(fields: [patientAccountId], references: [id])
  clinicId         String?
  type             NotificationType
  title            String
  body             String
  link             String?
  readAt           DateTime?
  createdAt        DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([patientAccountId, createdAt])
}
