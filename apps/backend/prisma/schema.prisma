generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STAFF)
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  isActive  Boolean  @default(true)
  appointments Appointment[]
  reproductiveHealthRecords ReproductiveHealthRecord[]
  passwordResetTokens PasswordResetToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Clinic {
  id        String   @id @default(uuid())
  name      String
  facilityType FacilityType @default(CLINIC)
  phone     String
  address   String
  district      String?
  subCounty     String?
  parish        String?
  parentFacilityId String?
  parentFacility   Clinic?  @relation("FacilityHierarchy", fields: [parentFacilityId], references: [id])
  childFacilities  Clinic[] @relation("FacilityHierarchy")
  users     User[]
  patients  Patient[]
  referralsFrom Referral[] @relation("ReferralFrom")
  referralsTo   Referral[] @relation("ReferralTo")
  dhis2Integration Dhis2Integration?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dhis2Integration {
  id             String   @id @default(uuid())
  clinicId       String   @unique
  clinic         Clinic   @relation(fields: [clinicId], references: [id])
  baseUrl        String
  username       String
  encryptedPassword String
  orgUnitId      String
  dataElementMap Json     @default("{}")
  lastPushedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum FacilityType {
  CLINIC
  HEALTH_CENTRE_II
  HEALTH_CENTRE_III
  HEALTH_CENTRE_IV
  HOSPITAL
  LABORATORY
  PHARMACY
  COMMUNITY_OUTREACH
  MOBILE_UNIT
}

model Patient {
  id           String        @id @default(uuid())
  name         String
  phone        String
  sex          Sex?
  dateOfBirth  DateTime?
  village      String?
  parish       String?
  subCounty    String?
  district     String?
  nextOfKinName  String?
  nextOfKinPhone String?
  consentGivenAt  DateTime?
  consentGivenBy  String?
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[]
  consultations Consultation[]
  labTests LabTest[]
  reproductiveHealthRecords ReproductiveHealthRecord[]
  referrals    Referral[]
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([clinicId])
}

model Referral {
  id           String   @id @default(uuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  fromClinicId String
  fromClinic   Clinic   @relation("ReferralFrom", fields: [fromClinicId], references: [id])
  toClinicId   String
  toClinic     Clinic   @relation("ReferralTo", fields: [toClinicId], references: [id])
  reason       String
  status       ReferralStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([fromClinicId])
  @@index([toClinicId])
  @@index([patientId])
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum Sex {
  FEMALE
  MALE
  OTHER
}

model ReproductiveHealthRecord {
  id                      String   @id @default(uuid())
  patientId               String
  patient                 Patient  @relation(fields: [patientId], references: [id])
  recordedById            String
  recordedBy              User     @relation(fields: [recordedById], references: [id])
  lastMenstrualPeriodDate DateTime?
  cycleLengthDays         Int?
  flowDurationDays        Int?
  familyPlanningMethod    FamilyPlanningMethod @default(NONE)
  pregnancyStatus         PregnancyStatus @default(UNKNOWN)
  gravida                 Int?
  para                    Int?
  notes                   String?
  deletedAt               DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([patientId])
}

enum FamilyPlanningMethod {
  NONE
  CONDOM
  PILL
  INJECTABLE
  IMPLANT
  IUD
  NATURAL
  PERMANENT
  OTHER
}

enum PregnancyStatus {
  UNKNOWN
  NOT_PREGNANT
  PREGNANT
  POSTPARTUM
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  PHARMACIST
  NURSE
  STAFF
}

model Appointment {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      User     @relation(fields: [doctorId], references: [id])
  clinicId    String
  date        DateTime
  time        String
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  consultation Consultation?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clinicId, date])
  @@index([patientId])
  @@index([doctorId])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Consultation {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  diagnosis     String
  symptoms      String
  serviceTags   String[] @default([])
  prescriptions Prescription[]
  invoice       Invoice?
  labTests LabTest[]
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([patientId])
}

model Prescription {
  id              String       @id @default(uuid())
  consultationId  String
  consultation    Consultation @relation(fields: [consultationId], references: [id])
  medication      String
  dosage          String
  frequency       String
  duration        String
  createdAt       DateTime     @default(now())

  @@index([consultationId])
}

model Invoice {
  id              String       @id @default(uuid())
  consultationId  String       @unique
  consultation    Consultation @relation(fields: [consultationId], references: [id])
  clinicId        String
  amount          Float
  status          InvoiceStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([clinicId, status])
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

model Medicine {
  id          String   @id @default(uuid())
  clinicId    String
  name        String
  quantity    Int
  unit        String
  reorderLevel Int
  price       Float
  expiryDate  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clinicId])
}

model LabTest {
  id              String   @id @default(uuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  consultationId  String?
  consultation    Consultation? @relation(fields: [consultationId], references: [id])
  testName        String
  results         String
  status          LabStatus @default(PENDING)
  orderedBy       String
  completedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([patientId])
  @@index([consultationId])
}

enum LabStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model SyncConflictLog {
  id               String   @id @default(uuid())
  entity           String
  recordId         String
  clinicId         String
  mutationId       String
  incomingUpdatedAt DateTime
  currentUpdatedAt  DateTime
  createdAt        DateTime @default(now())

  @@index([clinicId])
  @@index([recordId])
}

model AuditLog {
  id         String   @id @default(uuid())
  entity     String
  recordId   String
  clinicId   String
  action     AuditAction
  actorUserId String
  actorRole  String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([clinicId])
  @@index([entity, recordId])
}

enum AuditAction {
  CREATE
  UPDATE
  DEACTIVATE
  DELETE
}
