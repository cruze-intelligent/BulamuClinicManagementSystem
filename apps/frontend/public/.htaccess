# One address for the site: www.bulamu.site goes to bulamu.site. Sign-ins and
# saved work belong to the address they were made on, and the API accepts
# calls from Bulamu's own site.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.bulamu\.site$ [NC]
  RewriteRule ^ https://bulamu.site%{REQUEST_URI} [R=301,L]
</IfModule>

# Hostinger's CDN keeps .js files for a week. The service worker and the app
# manifest must reach devices on the next visit after a deploy, so they are
# never cached (the browser still checks them only when the app is opened).
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
