POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://bulamu_user:change-me@localhost:5432/bulamu?schema=public
JWT_SECRET=replace-with-a-long-random-secret
INTEGRATION_ENCRYPTION_KEY=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Pesapal (subscription billing) - sandbox by default, see DEPLOYMENT.md
PESAPAL_CONSUMER_KEY=replace-with-your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=replace-with-your-pesapal-consumer-secret
PESAPAL_ENV=sandbox
PESAPAL_IPN_ID=replace-after-running-POST-/billing/pesapal/register-ipn

# Google Sheets lead capture (landing page "Request evaluation access" form)
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace-with-service-account-email
GOOGLE_PRIVATE_KEY=replace-with-service-account-private-key
GOOGLE_SHEET_ID=replace-with-target-sheet-id

# Transactional email (password reset, facility-approved, subscription
# receipts) - any SMTP provider works (Hostinger email hosting, Gmail app
# password, or an SMTP relay from SendGrid/Mailgun/Postmark). Omit entirely to
# leave email disabled - password reset links are logged server-side instead.
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="Bulamu <no-reply@bulamu.ug>"

# Google Analytics (public tag - not a secret, but overridable per environment)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-3BR26WNYPE
# Set once the Hostinger domain is live - used for canonical/OG URLs and the sitemap
NEXT_PUBLIC_SITE_URL=https://bulamu.ug
